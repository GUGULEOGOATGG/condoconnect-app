# Copie para .env na raiz. Variáveis do servidor têm prioridade.
APP_BASE_PATH=/sisc-test
APP_AUTO_MIGRATE=0
# Contas fictícias do SQL têm senha pública; habilite somente em demonstração.
APP_DEMO_LOGIN=0
# Origem pública sem caminho, para links enviados por e-mail.
APP_URL=http://localhost
# Defina 1 somente se o proxy recebe HTTPS e termina TLS antes do PHP.
APP_HTTPS=0
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=db_sisc
DB_USER=
DB_PASS=
# DB_DATABASE, DB_USERNAME e DB_PASSWORD também são aceitos.
# Segundos que o PHP espera o MySQL aceitar a conexão (1 a 15). O app desiste em 20 s.
DB_TIMEOUT=5
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=CondoConnect
BREVO_SMTP_HOST=smtp-relay.brevo.com
# TLS implícito em 465; 587 também é aceito, com STARTTLS obrigatório.
BREVO_SMTP_PORT=465
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_REDIRECT_URI=
MERCADOPAGO_SANDBOX=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

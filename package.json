{
  "name": "condoconnect",
  "private": true,
  "version": "1.0.0",
  "dependencies": {
    "@netlify/blobs": "^8.1.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "pretest:coverage": "node -e \"require('node:fs').mkdirSync('test-results', { recursive: true })\"",
    "test:coverage": "node --experimental-test-coverage --test-coverage-include=frontend/assets/js/main.js --test-coverage-include=assets/js/main.js --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=test-results/javascript.lcov --test tests/*.test.mjs",
    "lint": "node tools/check-syntax.mjs",
    "build:static": "node tools/build-static.mjs",
    "dev": "netlify dev",
    "deploy": "npm run build:static && netlify deploy"
  },
  "devDependencies": {
    "@iarna/toml": "^2.2.5",
    "jsdom": "26.1.0",
    "parse5": "^8.0.1",
    "postcss": "^8.5.28",
    "yaml": "^2.9.1"
  }
}
